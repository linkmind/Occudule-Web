# Postmark (waitlist + contact forms)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
WAITLIST_NOTIFY_EMAIL=
# Optional — defaults to WAITLIST_NOTIFY_EMAIL, then support@occudule.com
# CONTACT_NOTIFY_EMAIL=

# Optional: Postmark message stream (defaults to "outbound")
# POSTMARK_MESSAGE_STREAM=outbound

# Zoho SalesIQ live chat (Contact page) — widget code from Zoho SalesIQ → Settings → Embed
# Public var required for the browser widget script
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=
