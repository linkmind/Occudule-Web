# Waitlist form — recommended: Postmark (same stack as the Occudule app)
# Set these in Vercel → Settings → Environment Variables (Production + Preview)

# Postmark Server API token (Server → API Tokens)
POSTMARK_SERVER_TOKEN=your-server-token

# Verified sender signature in Postmark (e.g. support@occudule.com or noreply@occudule.com)
POSTMARK_FROM_EMAIL=Occudule <support@occudule.com>

# Where team notifications are sent (defaults to support@occudule.com)
WAITLIST_NOTIFY_EMAIL=support@occudule.com

# Optional: Postmark message stream (defaults to "outbound")
# POSTMARK_MESSAGE_STREAM=outbound


