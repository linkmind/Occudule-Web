# Postmark (waitlist + contact forms)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
WAITLIST_NOTIFY_EMAIL=
# Optional — defaults to WAITLIST_NOTIFY_EMAIL, then support@occudule.com
# CONTACT_NOTIFY_EMAIL=

# Optional: Postmark message stream (defaults to "outbound")
# POSTMARK_MESSAGE_STREAM=outbound

# ─── Zoho SalesIQ live chat (Contact page) ───────────────────────────────────
# Public widget embed code (browser script), NOT a Zoho OAuth/API secret.
#
# Where to find it:
#   1. Log in to your SalesIQ portal (e.g. salesiq.zoho.com or salesiq.zoho.ca)
#   2. Settings → Brands → [your brand] → Installation → Website
#   3. From the embed snippet, copy:
#      - the value after wc= in the script src (most common), OR
#      - the widgetcode:"..." value (some US embeds)
#      - the host in the script src (e.g. salesiq.zohopublic.ca)
#
# Canada example:
#   <script id="zsiqscript" src="https://salesiq.zohopublic.ca/widget?wc=abc123..." defer>
#   → NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=abc123...
#   → NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_HOST=salesiq.zohopublic.ca
#
# Add to .env.local (never commit .env.local), then restart: npm run dev
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_HOST=salesiq.zohopublic.ca
