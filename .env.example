# Postmark (waitlist + contact forms)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
WAITLIST_NOTIFY_EMAIL=
# Optional — defaults to WAITLIST_NOTIFY_EMAIL, then support@occudule.com
# CONTACT_NOTIFY_EMAIL=

# Optional: Postmark message stream (defaults to "outbound")
# POSTMARK_MESSAGE_STREAM=outbound

# ─── Zoho SalesIQ live chat (Contact page) ───────────────────────────────────
# This is the public *widget embed code* (browser script), NOT a Zoho OAuth/API secret.
#
# Where to find it:
#   1. Log in to https://salesiq.zoho.com
#   2. Settings → Brands → [your brand] → Embed
#   3. Copy the widget script URL; the value after wc= is your widget code, e.g.:
#      https://salesiq.zohopublic.com/widget?wc=abc123xyz456
#      → use: NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=abc123xyz456
#
# Add to .env.local (never commit .env.local), then restart: npm run dev
NEXT_PUBLIC_ZOHO_SALESIQ_WIDGET_CODE=
